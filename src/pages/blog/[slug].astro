---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { marked } from 'marked';

const { slug } = Astro.params;

let post: any = null;
let htmlContent = '';

try {
  const url = new URL(`/api/post/${slug}`, Astro.url);
  const res = await fetch(url.toString());
  if (res.ok) {
    post = await res.json();
    // Configure marked for clean HTML
    marked.setOptions({ gfm: true, breaks: true });
    htmlContent = await marked(post.content || '');
  }
} catch (e) {
  post = null;
}

const formattedDate = post?.date
  ? new Date(post.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
const initials = post?.author ? post.author.split(' ').map((n: string) => n[0]).join('').slice(0, 2).toUpperCase() : 'A';
---

<BaseLayout
  title={post ? `${post.title} — Blog` : 'Post no encontrado'}
  description={post?.excerpt || ''}
>
  <div class="container">
    {!post ? (
      <div class="empty-state" style="padding-top: 5rem">
        <span class="icon">✦</span>
        <h3>Post no encontrado</h3>
        <p>El artículo que buscas no existe o fue eliminado.</p>
        <a href="/" class="btn-primary">Volver al inicio</a>
      </div>
    ) : (
      <article class="fade-up">
        <a href="/" class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
          Volver a Insights
        </a>

        <header class="article-header">
          <h1 class="article-title">{post.title}</h1>
          <div class="article-meta">
            <div class="article-meta-item article-meta-author">
              <div class="avatar" style="width:36px;height:36px;font-size:0.85rem">{initials}</div>
              <div>
                <div class="article-meta-label">Autor</div>
                <div class="article-meta-value">{post.author || 'Anónimo'}</div>
              </div>
            </div>
            {post.category && (
              <div class="article-meta-item">
                <div class="article-meta-label">Categoría</div>
                <div class="article-meta-value">
                  <span class="pill" style="padding: 0.2rem 0.7rem">{post.category}</span>
                </div>
              </div>
            )}
            {formattedDate && (
              <div class="article-meta-item">
                <div class="article-meta-label">Fecha</div>
                <div class="article-meta-value">{formattedDate}</div>
              </div>
            )}
          </div>
        </header>

        {post.coverImage ? (
          <img class="article-hero" src={post.coverImage} alt={post.title} />
        ) : (
          <div class="article-hero-placeholder" />
        )}

        <div class="prose" set:html={htmlContent} />
      </article>
    )}
  </div>
</BaseLayout>
